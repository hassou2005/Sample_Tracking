# PostgreSQL Database Connection Variables
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=labtrack_db
DATABASE_USER=postgres
DATABASE_PASSWORD=0000
DATABASE_URL=postgresql://postgres:0000@localhost:5432/lab_db

# Security & JWT Token Authentication
JWT_SECRET_KEY=dev_secret_key_change_in_production_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application Details
APP_NAME="LabTrack Pro — Laboratory Sample Tracking & Traceability System"
DEBUG=True
SEED_ADMIN_PASSWORD=change_me_admin_password
SEED_TECH_PASSWORD=change_me_tech_password